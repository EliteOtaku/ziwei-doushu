# 复制为 .env.local 后填入实际值
# 只想排盘、看命盘的话全部留空即可 —— 排盘与命盘展示不需要任何密钥。
#
# 以下是 AI 解读（/api/interpret）与合盘 AI 分析（/api/heming）的配置。
# 接口走 OpenAI 兼容协议（POST {BASE_URL}/chat/completions，SSE 流式），
# 按 DeepSeek 官方 API 规范实现，因此任何兼容该协议的服务都能接：
# DeepSeek 官方、Azure OpenAI、各类中转站、本地 vLLM / Ollama / one-api 等。

# ─── 必填：选一个通道 ───
# 可选值：deepseek（默认）、opendesign，或任意自定名称。
# 写自定名称时必须同时给下面三个变量。
AI_PROVIDER=deepseek

# ─── DeepSeek 官方（https://platform.deepseek.com/api_keys）───
# 预设 BASE_URL=https://api.deepseek.com/v1，预设 MODEL=deepseek-flash
# 可选模型：deepseek-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── OpenDesign（有订阅时用这个）───
# 预设 BASE_URL=https://amr-link.open-design.ai/v1，预设 MODEL=deepseek-v4.1-flash
# 用法：把上面的 AI_PROVIDER 改成 opendesign，再填下面这行
# OPENDESIGN_API_KEY=your-opendesign-api-key
# OPENDESIGN_MODEL=deepseek-v4.1-flash
# 可选：glm-5.3-flash / deepseek-v4-pro / kimi-k2.7-code 等（以 /v1/models 返回为准）

# ─── 其他 OpenAI 兼容服务 / 自建 ───
# 变量名规则：<PROVIDER 大写，非字母数字转下划线>_API_KEY / _BASE_URL / _MODEL
# 例：AI_PROVIDER=mimo 时读写 MIMO_API_KEY、MIMO_BASE_URL、MIMO_MODEL
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 通用兜底（配了就以它为准，不分通道）───
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ─── 调优（一般不用动）───
#
# 单次回复的内容预算。**默认不设**，此时不上送 max_tokens，
# 由上游按官方默认处理：非思考 8K、思考 64K（effort=max 时 128K）。
# 只有确实需要限制时才填，取值上限 393216。
# AI_MAX_TOKENS=16384
#
# 空闲超时（毫秒）：连续这么久没收到任何数据才中断。
# 注意这不是「整条流的总时长」—— 思考模式生成长文可能跑几分钟，
# 用固定总时长会误杀正常请求。
# AI_IDLE_TIMEOUT_MS=120000
#
# 思考等级：none / low / high / max（也接受 minimal/medium/xhigh/ultra 别名）。
# 不填则用官方默认（high，即全程思考）。
# 命理解读这类任务通常不需要深度思考，设 none 可显著降低 token 消耗与延迟。
# AI_REASONING_EFFORT=none
#
# 429 / 500 / 503 的最大尝试次数（含首次）与指数退避基准毫秒。
# AI_MAX_ATTEMPTS=3
# AI_RETRY_BASE_MS=1000
#
# 是否请求 token 用量统计（stream_options.include_usage），默认开启。
# AI_INCLUDE_USAGE=true

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
